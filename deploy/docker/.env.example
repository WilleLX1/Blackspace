# Runtime values are intentionally supplied through files in deploy/docker/secrets.
# Run ../../scripts/init-dev-secrets.ps1 before starting Compose.
BLACKSPACE_ENV=development
BLACKSPACE_INSTANCE_NAME=Blackspace Private Alpha
BLACKSPACE_ONION_ORIGIN=http://replace-with-56-character-hostname.onion
# The externally reachable HTTPS origin, advertised in invitations so HTTPS Web
# peers can deposit. Must match exactly what a browser sees. A non-default port
# is allowed when 443 is used by another service, e.g.
# BLACKSPACE_HTTPS_ORIGIN=https://msg.example.com:8443
BLACKSPACE_HTTPS_ORIGIN=
# Bare DNS hostname only: no https:// prefix, path, or port.
BLACKSPACE_HTTPS_DOMAIN=
BLACKSPACE_ACME_EMAIL=
# Host ports published to Caddy's internal ports 80 and 443. Change these when
# another service owns the standard ports (for example 7080 and 7443).
BLACKSPACE_HTTP_PORT=80
BLACKSPACE_HTTPS_PORT=443
