{
  "openapi": "3.1.0",
  "info": {
    "title": "Blackspace private-alpha messaging protocol",
    "description": "Unaudited private-alpha protocol for invited, identity-bound, end-to-end encrypted one-to-one messaging over opaque mailbox servers.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
